# Server Configuration
PORT=5000

# Database Configuration
# In production, use MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/proofsy
MONGODB_URI=mongodb://localhost:27017/proofsy

# Frontend Integration
# Used for CORS whitelist and email generation links
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Backend Integration
# The public URL where this backend is hosted, used for PDF download links in emails
BACKEND_URL=http://localhost:5000

# Email Delivery (Optional but recommended)
# Choose one of the following methods:

# Method 1: SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key

# Method 2: Custom SMTP (e.g. Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=your_email@gmail.com
